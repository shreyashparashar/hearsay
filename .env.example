# Pick ONE way to give Hearsay a free AI model (it works without one, but only with a keyword reader).

# 1) Google AI Studio (free tier, reads images): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# optional: pick the model (check AI Studio for the current free Flash model name)
# CROWDSIM_LLM_MODEL=gemini-flash-latest

# 2) Any OpenAI-compatible provider (OpenRouter free models, Groq, etc.)
# CROWDSIM_LLM_BASE_URL=https://openrouter.ai/api/v1
# CROWDSIM_LLM_API_KEY=
# CROWDSIM_LLM_MODEL=
# CROWDSIM_VISION_MODEL=        # if your text model can't see images

# 3) Local and fully free: Ollama (https://ollama.com), then `ollama pull qwen2.5vl:7b`
# CROWDSIM_USE_OLLAMA=1
# CROWDSIM_LLM_MODEL=qwen2.5vl:7b

# Limit crowd size on small servers
# CROWDSIM_MAX_AGENTS=1000000
